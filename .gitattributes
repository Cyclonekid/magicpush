# Auto detect text files and perform LF normalization
* text=auto

# Force LF for all text files
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.less text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.java text eol=lf
*.rb text eol=lf
*.php text eol=lf
*.go text eol=lf
*.rs text eol=lf
*.sql text eol=lf
*.conf text eol=lf
*.ini text eol=lf
*.env text eol=lf
*.dockerfile text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

# Binary files should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.fpk binary
